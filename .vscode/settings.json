{
    "python.analysis.extraPaths": ["${workspaceFolder}/sample_state_machine"],
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none"
    },
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": false,
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "files.associations": {
        "*.conf": "ini"
    },
    "[python]": {
        "editor.rulers": [120]
    },
    "[xml]": {
        "editor.tabSize": 4
    }
}
