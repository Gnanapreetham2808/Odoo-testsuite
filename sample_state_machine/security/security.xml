<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sample_booking_user" model="res.groups">
        <field name="name">Booking User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sample_booking_manager" model="res.groups">
        <field name="name">Booking Manager</field>
        <field name="implied_ids" eval="[(4, ref('sample_state_machine.group_sample_booking_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_sample_booking_own" model="ir.rule">
            <field name="name">Booking: users see their own requests</field>
            <field name="model_id" ref="model_sample_booking"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sample_state_machine.group_sample_booking_user'))]"/>
        </record>

        <record id="rule_sample_booking_all" model="ir.rule">
            <field name="name">Booking: managers see all requests</field>
            <field name="model_id" ref="model_sample_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sample_state_machine.group_sample_booking_manager'))]"/>
        </record>
    </data>
</odoo>
